# Copie ce fichier en .env et remplis seulement les clés que tu veux.
# Tout marche sans aucune clé.

PORT=4321
DEFAULT_COUNTRY=fr
DEFAULT_LANG=fr

# Positions Google réelles (2 500 recherches offertes) : https://serper.dev
SERPER_API_KEY=

# Test de visibilité IA, gratuit : https://console.groq.com/keys
GROQ_API_KEY=

# Test dans ChatGPT : https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Test dans Claude : https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Core Web Vitals officiels, gratuit : https://developers.google.com/speed/docs/insights/v5/get-started
GOOGLE_API_KEY=

# Score d'autorité plus précis, gratuit : https://www.domcop.com/openpagerank/
OPENPAGERANK_API_KEY=

# Volumes de recherche exacts (payant, très peu cher) : https://dataforseo.com
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Optionnel : forcer un modèle précis
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_MODEL=gpt-5-mini
# ANTHROPIC_MODEL=claude-haiku-5-5
